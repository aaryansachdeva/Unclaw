{
  "name": "unclaw",
  "version": "1.0.13",
  "description": "Unclaw",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist": "npm run dist:win"
  },
  "keywords": [],
  "author": "Foton Labs",
  "license": "ISC",
  "build": {
    "appId": "app.unclaw.unclaw",
    "productName": "Unclaw",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://files.fotonlabs.com/mac/electron/",
        "channel": "latest"
      }
    ],
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/notarize-dmg.js",
    "extraResources": [
      {
        "from": "../soul",
        "to": "soul-src",
        "filter": [
          "run_soul.sh",
          "pyproject.toml",
          "requirements-mac.txt",
          "soul/**/*",
          "!soul/__pycache__/**",
          "!soul/**/__pycache__/**",
          "!soul/data/**",
          "!**/.venv/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "build/resources/uv",
        "to": "uv",
        "filter": [
          "uv",
          "uvx"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Unclaw Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unclaw",
      "uninstallDisplayName": "Unclaw",
      "include": null
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "Unclaw-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Aryan Sachdeva (9JPN4E9MJK)",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Unclaw uses the microphone for voice conversations with your AI companion.",
        "NSCameraUsageDescription": "Unclaw can optionally use the camera to share visual context with your AI companion.",
        "NSAppleEventsUsageDescription": "Unclaw uses Apple Events to coordinate its streaming sub-process.",
        "NSHighResolutionCapable": true,
        "LSUIElement": false
      }
    },
    "dmg": {
      "title": "Unclaw ${version}",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Foton Labs",
      "artifactName": "Unclaw ${version} ${arch}.${ext}"
    }
  },
  "dependencies": {
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.6": "^0.2.5",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "onnxruntime-web": "^1.24.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.1"
  }
}
