{
  "name": "unclaw",
  "version": "1.0.2",
  "description": "Unclaw",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist": "npm run dist:win"
  },
  "keywords": [],
  "author": "Foton Labs",
  "license": "ISC",
  "build": {
    "appId": "app.unclaw.unclaw",
    "productName": "Unclaw",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Unclaw Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unclaw",
      "uninstallDisplayName": "Unclaw",
      "include": null
    }
  },
  "dependencies": {
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.6": "^0.2.5",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "onnxruntime-web": "^1.24.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.1"
  }
}
